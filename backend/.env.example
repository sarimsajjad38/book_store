# =================================================================
# BookNest Backend Production Environment Configuration
# =================================================================
# Duplicate this file as .env and replace placeholders with production secrets.

NODE_ENV=production
PORT=5001

# -----------------------------------------------------------------
# 1. MongoDB Database Connection
# -----------------------------------------------------------------
# For MongoDB Atlas (Free Tier M0 or Dedicated M10+):
# 1. Go to https://cloud.mongodb.com -> Build a Cluster -> Database Access (create user).
# 2. Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0) for Cloud Run/Render/Railway.
# 3. Connect -> Drivers (Node.js) -> Copy connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/booknest?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 2. Authentication & JWT Security
# -----------------------------------------------------------------
# Generate a strong 64-char key in terminal using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRE=30d

# -----------------------------------------------------------------
# 3. Razorpay Payment Gateway (Live or Test Mode)
# -----------------------------------------------------------------
# Obtain these from your Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_key_secret

# -----------------------------------------------------------------
# 4. CORS & Security
# -----------------------------------------------------------------
# Comma-separated list of allowed origins, or * for universal access (e.g. mobile apps)
CLIENT_ORIGINS=*
