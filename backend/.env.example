# BookNest Backend Environment Configuration
NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknest?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/booknest

# JSON Web Token Secret (generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRE=30d

# Allowed client origins for CORS (comma-separated, or * for all)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5000,https://your-domain.web.app

