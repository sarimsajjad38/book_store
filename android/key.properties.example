# Template for release signing properties
# Generate keystore with:
# keytool -genkey -v -keystore app/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Copy this file to android/key.properties (do NOT commit key.properties to git)
storePassword=your_store_password_here
keyPassword=your_key_password_here
keyAlias=upload
storeFile=upload-keystore.jks

